# Application Configuration
PORT=8000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shubh_ausar?schema=public"

# JWT Authentication Configuration
JWT_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Bcrypt Security Configuration
BCRYPT_SALT_ROUNDS=12

# Express Rate Limiting
RATE_LIMIT_WINDOW_MS=86400000 # 24 hours (86,400,000 ms)
RATE_LIMIT_MAX=5000 # 5000 requests per 24 hours

# Nodemailer Configuration (SMTP Email service)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Shubh Ausar <no-reply@shubhausar.com>"

# Cloudinary Storage Configuration (Vehicle and profile images)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# File Storage Configuration
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

